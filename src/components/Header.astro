---
import Navigation from "./Navigation.astro";
let userData = {};
try {
  const res = await fetch("https://api.github.com/users/a-gracia");
  if (res.ok) {
    userData = await res.json();
  }
} catch {
  // fetch failed — render without profile picture
}
---

<header>
  <div class="header-content">
    <div class="name-container">
      <a class="name-title" href="/">Andrés Gracia</a>
      <span class="accent-line"></span>
    </div>
    <nav>
      <Navigation />
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: none;
    padding-bottom: var(--space-md);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
  }

  .name-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .name-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .name-title:hover {
    color: var(--text-primary);
  }

  .accent-line {
    display: block;
    width: 40px;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
  }

  @media (min-width: 641px) {
    .header-content {
      flex-direction: row;
      justify-content: space-between;
    }

    .name-container {
      align-items: flex-start;
    }
  }
</style>
