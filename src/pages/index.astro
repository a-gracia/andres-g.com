---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import rischioPreview from "../assets/projects/rischio.io.png";
import Repositories from "../components/Repositories.astro";

let avatarUrl = "";
try {
  const res = await fetch("https://api.github.com/users/a-gracia");
  if (res.ok) {
    const data = await res.json();
    avatarUrl = data.avatar_url;
  }
} catch {}

const projects = [
  {
    name: "Rischio.io",
    url: "https://rischio.io",
    image: rischioPreview,
    description:
      "Design and analyze geotechnical engineering structures such as retaining walls, deep foundations and shallow foundations.",
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    {avatarUrl && <img class="hero-avatar" src={avatarUrl} alt="Andrés Gracia" />}
    <h1>Andrés Gracia</h1>
    <p class="subtitle">Civil Engineer, MSc & MBA · Ruby on Rails, Python & React Developer · Scientific Programmer</p>
    <div class="hero-links">
      <a href="https://github.com/a-gracia" target="_blank" class="tag">GitHub</a>
      <a href="https://linkedin.com/in/AndresGraciaDanies" target="_blank" class="tag">LinkedIn</a>
      <a href="/blog/" class="tag">Blog</a>
    </div>
  </section>

  <!-- Featured Project -->
  <section class="featured">
    <h2>Featured Project</h2>
    <div class="card-container">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Repositories -->
  <section class="repos">
    <h2>Open Source</h2>
    <div class="card-container">
      <Repositories />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0 var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 3px solid var(--border);
    margin-bottom: var(--space-lg);
    object-fit: cover;
  }

  .hero h1 {
    font-family: var(--font-body);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 600px;
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .featured {
    padding: var(--space-xl) 0;
  }

  .repos {
    padding: var(--space-xl) 0;
  }
</style>
