---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Contact">
  <h1>Contact</h1>

  <p>
    I'm always open to new opportunities, collaborations, or just a good
    conversation.
  </p>

  <p>
    If you have a project in mind, a question, or think we could work together,
    feel free to reach out.
  </p>

  <div class="contact-links">
    <a href="mailto:graciadanies@gmail.com" class="contact-item">
      <span class="contact-label">Email</span>
      <span class="contact-value">graciadanies@gmail.com</span>
    </a>
    <a href="https://github.com/a-gracia" target="_blank" class="contact-item">
      <span class="contact-label">GitHub</span>
      <span class="contact-value">github.com/a-gracia</span>
    </a>
    <a href="https://linkedin.com/in/AndresGraciaDanies" target="_blank" class="contact-item">
      <span class="contact-label">LinkedIn</span>
      <span class="contact-value">linkedin.com/in/AndresGraciaDanies</span>
    </a>
  </div>
</BaseLayout>

<style>
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .contact-item:hover {
    border-color: var(--accent);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .contact-value {
    font-size: 1rem;
    color: var(--text-primary);
  }

  .contact-item:hover .contact-value {
    color: var(--accent);
  }
</style>
